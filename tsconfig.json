{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@repo/types": ["./packages/types/src/index.ts"],
      "@repo/core": ["./packages/core/src/index.ts"],
      "@repo/search": ["./packages/search/src/index.ts"],
      "@repo/verification": ["./packages/verification/src/index.ts"],
      "@repo/reasoning": ["./packages/reasoning/src/index.ts"],
      "@repo/reporting": ["./packages/reporting/src/index.ts"],
      "@repo/memory": ["./packages/memory/src/index.ts"],
      "@repo/orchestration": ["./packages/orchestration/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts"]
}
